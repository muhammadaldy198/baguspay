NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_NAME="Baguspay Admin Preview"

# Generate unique secrets. Never commit their real values.
APP_KEY=
JWT_SECRET=

SESSION_DRIVER=cookie
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baguspay

# The local filesystem is enough for a temporary admin preview.
DRIVE_DISK=fs
VITE_S3_URL=/uploads

# Required by the database seeder. Choose your own values.
PREVIEW_ADMIN_EMAIL=
PREVIEW_ADMIN_PASSWORD=
PREVIEW_ADMIN_NAME="Preview Admin"
PREVIEW_ADMIN_PHONE=080000000000

# Optional. Leave empty while only reviewing the admin panel.
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_CALLBACK_SECRET=

# Optional S3-compatible storage. Set DRIVE_DISK=s3 to enable it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
