FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV HUSKY=0

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/web-admin/package.json apps/web-admin/package.json
COPY packages/configs/package.json packages/configs/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/tailwind-config/package.json packages/tailwind-config/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
COPY packages/ui/package.json packages/ui/package.json

RUN pnpm install --frozen-lockfile

COPY apps/web-admin apps/web-admin
COPY packages/configs packages/configs
COPY packages/db packages/db
COPY packages/tailwind-config packages/tailwind-config
COPY packages/typescript-config packages/typescript-config
COPY packages/ui packages/ui

RUN NODE_ENV=production \
    PORT=10000 \
    HOST=0.0.0.0 \
    LOG_LEVEL=info \
    APP_NAME="Baguspay Admin Preview" \
    APP_KEY=build-only-key-not-used-at-runtime \
    JWT_SECRET=build-only-jwt-not-used-at-runtime \
    SESSION_DRIVER=cookie \
    DATABASE_URL=postgresql://preview:preview@localhost:5432/preview \
    DRIVE_DISK=fs \
    VITE_S3_URL=/uploads \
    pnpm --filter web-admin... run build

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=10000

EXPOSE 10000

CMD ["sh", "-c", "pnpm --filter @baguspay/db db:migrate && pnpm --filter @baguspay/db db:seed && pnpm --filter web-admin start"]
